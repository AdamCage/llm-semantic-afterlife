# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.key
secrets/

# ---------------------------------------------------------------------------
# Experiment outputs
# ---------------------------------------------------------------------------
# `runs/` holds raw trajectories and full logs: large, regenerable from configs.
# Small, publication-grade artifacts live in `artifacts/` and ARE committed.
# Occupancy replication (ADR-0022) is tracked so the panel cannot vanish with
# a VM. Do not un-ignore other stages. Secrets stay in `.env`, never here.
runs/*
!runs/.gitkeep
!runs/_ledger/
!runs/_ledger/**
!runs/s5/
runs/s5/*
!runs/s5/s5-lock-occupancy-repl-*/
!runs/s5/s5-lock-occupancy-repl-*/**
!runs/s5/s5-embed-lock-occupancy-repl-*/
!runs/s5/s5-embed-lock-occupancy-repl-*/**
!runs/s6/
runs/s6/*
!runs/s6/s6-embed-third-space-*/
!runs/s6/s6-embed-third-space-*/**
.cache/
scratch/

# Content-addressed caches: responses, embeddings and tokenizer files. All
# regenerable, and large (a single tokenizer.json is ~2 MB; Stage 1 will produce
# ~15k cached responses). The response cache IS the mechanism for level-L3
# reproduction without an API key, but it ships as a versioned artifact release
# alongside the paper, not in the working tree.
cache/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.tox/
.nox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_convert*

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# LaTeX build products
# ---------------------------------------------------------------------------
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.fdb_latexmk
paper/**/*.fls
paper/**/*.log
paper/**/*.out
paper/**/*.synctex.gz
paper/**/*.toc
paper/**/*.pdf
paper/build/
!paper/releases/*.pdf
