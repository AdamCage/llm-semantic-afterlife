# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.key
secrets/

# ---------------------------------------------------------------------------
# Experiment outputs
# ---------------------------------------------------------------------------
# `runs/` holds raw trajectories and full logs: large, regenerable from configs.
# Small, publication-grade artifacts live in `artifacts/` and ARE committed.
# Occupancy replication (ADR-0022) and Paper B local generate (S8 smoke /
# S9 Qwen 12W / S10 OLMo 12W) are tracked so a VM wipe cannot erase the
# computational record. Secrets stay in `.env`, never here. Weights stay
# ignored.
runs/*
!runs/.gitkeep
!runs/_ledger/
!runs/_ledger/**
!runs/s5/
runs/s5/*
!runs/s5/s5-lock-occupancy-repl-*/
!runs/s5/s5-lock-occupancy-repl-*/**
!runs/s5/s5-embed-lock-occupancy-repl-*/
!runs/s5/s5-embed-lock-occupancy-repl-*/**
!runs/s5/s5-degeneracy-20260907T175009Z-f5accf8a/
!runs/s5/s5-degeneracy-20260907T175009Z-f5accf8a/**
!runs/s6/
runs/s6/*
!runs/s6/s6-embed-third-space-*/
!runs/s6/s6-embed-third-space-*/**
!runs/s8/
runs/s8/*
!runs/s8/s8-paperb-*/
!runs/s8/s8-paperb-*/**
!runs/s9/
runs/s9/*
!runs/s9/s9-paperb-*/
!runs/s9/s9-paperb-*/**
!runs/s9/s9-embed-*/
!runs/s9/s9-embed-*/**
!runs/s9/s9-degeneracy-*/
!runs/s9/s9-degeneracy-*/**
!runs/s10/
runs/s10/*
!runs/s10/s10-paperb-*/
!runs/s10/s10-paperb-*/**
!runs/s10/s10-embed-*/
!runs/s10/s10-embed-*/**
!runs/s10/s10-degeneracy-*/
!runs/s10/s10-degeneracy-*/**
!runs/s10/s10-persistence-*/
!runs/s10/s10-persistence-*/**
.cache/
scratch/

# Response and tokenizer caches stay out of git (large, regenerable).
# Embedding cache is tracked so hosted Qwen-embed and local BGE are not
# recomputed after a VM wipe (ADR-0027 / ADR-0028).
cache/*
!cache/embeddings/
!cache/embeddings/**

