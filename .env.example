# ===========================================================================
# llm-semantic-afterlife — environment template
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored and MUST NOT be committed.
#     cp .env.example .env       (Linux/macOS)
#     Copy-Item .env.example .env  (PowerShell)
#
# Every variable below is read through `semantic_afterlife.config.Settings`.
# Secrets are NEVER written into run manifests; only a truncated fingerprint
# (sha256 prefix) is logged so that runs can be attributed to a key without
# leaking it.
# ===========================================================================

# ---------------------------------------------------------------------------
# RouterAI — primary inference provider (https://routerai.ru/api/v1)
# ---------------------------------------------------------------------------
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# ---------------------------------------------------------------------------
# OpenRouter — secondary provider, used for cross-provider replication checks
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# Hugging Face — tokenizer downloads only (no model weights, no GPU needed).
# Required because sliding-window boundaries are defined in *generator*
# tokens, which means we need each generator's exact tokenizer locally.
# A read-only token is enough; needed for gated repos (e.g. Llama).
# ---------------------------------------------------------------------------
HF_TOKEN=

# ---------------------------------------------------------------------------
# Execution / safety rails
# ---------------------------------------------------------------------------
# Hard ceiling on money a single `afterlife` invocation may spend, in USD.
# The client refuses to issue a request that would cross this ceiling.
#
# This must cover the largest single arm you intend to run, because it applies to
# the whole invocation rather than per trajectory. `afterlife estimate` reports
# the forecast; if it exceeds this value the run aborts partway through, having
# already spent the ceiling. Stage 1's core arm forecasts $5.75, which is why the
# working value is 7.0 rather than the 5.0 chosen before the scale was known.
AFTERLIFE_BUDGET_USD_PER_RUN=7.0

# Hard ceiling for the whole project; tracked in `runs/_ledger/spend.jsonl`.
AFTERLIFE_BUDGET_USD_TOTAL=50.0

# RUB->USD rate used to normalise RouterAI's rouble pricing into the single
# currency reported in artifacts. Pinned per stage for reproducibility;
# the value actually used is recorded in every run manifest.
AFTERLIFE_USD_PER_RUB=0.0125

# `live` = real API calls. `replay` = serve from the on-disk response cache and
# fail if a request is missing (used by CI and by reproducibility audits).
# `mock` = deterministic synthetic generator, no network, no cost.
AFTERLIFE_EXECUTION_MODE=live

# ---------------------------------------------------------------------------
# Paths (absolute or relative to repo root)
# ---------------------------------------------------------------------------
AFTERLIFE_RUNS_DIR=runs
AFTERLIFE_ARTIFACTS_DIR=artifacts
AFTERLIFE_CACHE_DIR=cache

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
AFTERLIFE_LOG_LEVEL=INFO
# Also mirror every generated chunk into the human-readable log (very verbose).
AFTERLIFE_LOG_CHUNK_TEXT=false

# ---------------------------------------------------------------------------
# Concurrency
# ---------------------------------------------------------------------------
# Independent trajectories advanced in parallel. Each trajectory is strictly
# sequential internally (step t+1 depends on step t).
AFTERLIFE_MAX_CONCURRENT_TRAJECTORIES=4
AFTERLIFE_REQUEST_TIMEOUT_S=300
AFTERLIFE_MAX_RETRIES=6
